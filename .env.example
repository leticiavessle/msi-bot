# =====================================================================
# Variáveis do app. Copie este arquivo para ".env" (nunca envie o .env para ninguém).
# Na hospedagem (Cloudflare ou Vercel), cadastre as mesmas variáveis no painel.
# =====================================================================

# ---------- Supabase (Project Settings › API) ----------
# Públicas (vão para o navegador):
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Servidor (as duas primeiras repetem as de cima):
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRETA: dá acesso total ao banco. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- IA ----------
# SECRETA: embaralha a chave da IA salva no painel (Admin › Configurações › IA).
# Gere um texto aleatório longo (ex.: `openssl rand -hex 32`). Se trocar, salve a chave da IA de novo.
AI_SETTINGS_ENC_KEY=
# Opcional (reserva até salvar a chave no painel): openai | gemini
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_CHAT=
AI_MODEL_TASKS=

# ---------- Webhooks de compra (senha combinada com cada plataforma) ----------
# Sem a senha, a plataforma fica desligada (o endereço responde 503).
# Endereço para cadastrar: https://SEU-DOMINIO/api/public/webhooks/<hubla|payt|lastlink|cademi|kiwify>
#   Hubla: senha no cabeçalho x-hubla-token · Payt, LastLink e Cademí: ?token=<senha> no fim do endereço
WEBHOOK_SECRET_HUBLA=
WEBHOOK_SECRET_PAYT=
WEBHOOK_SECRET_LASTLINK=
WEBHOOK_SECRET_CADEMI=
WEBHOOK_SECRET_KIWIFY=
WEBHOOK_SECRET_GENERIC=

# ---------- Notificações no celular (Web Push / VAPID) ----------
# Gere um par novo: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@dominio.com

# ---------- Relatórios 08h e 17h ----------
# SECRETA: senha da API de relatórios (/api/relatorio/dados e /publicar).
REPORT_API_TOKEN=
# WhatsApp Cloud API (Meta › WhatsApp Manager)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
REPORT_WHATSAPP_TO=5500000000000

# ---------- Compilação ----------
# Hospedagem alvo do build: cloudflare-module (padrão) | vercel | node-server
# NITRO_PRESET=cloudflare-module
